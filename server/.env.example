# ---------- Core ----------
NODE_ENV=development
PORT=5000
# Local: mongodb://127.0.0.1:27017/pulse_chat   Atlas: mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/pulse_chat
MONGODB_URI=mongodb://127.0.0.1:27017/pulse_chat

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# ---------- CORS / cookies ----------
# Comma-separated list of allowed frontend origins. The first one is used in password-reset links.
CLIENT_URL=http://localhost:5173
# "none" when frontend and API are on different sites (Vercel + Render). "lax" when same-site/proxied.
COOKIE_SAMESITE=lax
# Optional, e.g. .example.com when API and app share a parent domain
COOKIE_DOMAIN=
# Number of reverse proxies in front of Node (Render / Nginx = 1)
TRUST_PROXY=1

# ---------- GIFs (GIPHY, server-side proxy; key never reaches the browser) ----------
GIPHY_API_KEY=

# ---------- Uploads (stored in MongoDB GridFS) ----------
MAX_IMAGE_MB=10
MAX_FILE_MB=20
# Video snaps: uploaded in resumable chunks, streamed back with HTTP Range requests
MAX_VIDEO_MB=50
MAX_VIDEO_SECONDS=30
UPLOAD_CHUNK_BYTES=1048576
DELETE_FOR_EVERYONE_MINUTES=60

# ---------- Password reset email (optional; without SMTP the link is printed to the console in development) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pulse Chat <no-reply@example.com>"

# ---------- Scaling (optional) ----------
# Set to enable the Socket.IO Redis adapter for multiple backend instances
REDIS_URL=

# Logging: LOG_LEVEL = debug | info | warn | error
# LOG_FORMAT = pretty (colored, default in development) | json (default in production)
LOG_LEVEL=info
LOG_FORMAT=
